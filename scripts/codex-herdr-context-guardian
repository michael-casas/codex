#!/usr/bin/env bash
set -euo pipefail

readonly state_dir="${CODEX_HERDR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/codex-herdr}"
readonly lease_path="${CODEX_HERDR_LEASE_PATH:-$state_dir/context.env}"
readonly interval_seconds="${CODEX_HERDR_GUARDIAN_INTERVAL_SECONDS:-5}"
readonly required_keys=(
  HERDR_ENV
  HERDR_SOCKET_PATH
  HERDR_WORKSPACE_ID
  HERDR_TAB_ID
  HERDR_PANE_ID
)

die() {
  local code="$1"
  shift
  printf 'codex-herdr-context-guardian: %s\n' "$*" >&2
  exit "$code"
}

[[ "${HERDR_ENV:-}" == "1" ]] || die 78 'must run inside a Herdr-managed pane'
for key in "${required_keys[@]:1}"; do
  [[ -n "${!key:-}" ]] || die 78 'Herdr caller context is incomplete'
done
[[ -S "$HERDR_SOCKET_PATH" ]] || die 78 'Herdr server socket is unavailable'
[[ "$interval_seconds" =~ ^[1-9][0-9]*$ ]] || die 64 'guardian interval must be positive'

umask 077
mkdir -p "$state_dir"
tmp_path="$lease_path.$$"

cleanup() {
  rm -f "$tmp_path"
  if [[ -f "$lease_path" ]] &&
    grep -qx "CODEX_HERDR_GUARDIAN_PID=$$" "$lease_path" 2>/dev/null; then
    rm -f "$lease_path"
  fi
}
trap cleanup EXIT INT TERM HUP

{
  printf 'HERDR_ENV=%q\n' "$HERDR_ENV"
  printf 'HERDR_SOCKET_PATH=%q\n' "$HERDR_SOCKET_PATH"
  printf 'HERDR_WORKSPACE_ID=%q\n' "$HERDR_WORKSPACE_ID"
  printf 'HERDR_TAB_ID=%q\n' "$HERDR_TAB_ID"
  printf 'HERDR_PANE_ID=%q\n' "$HERDR_PANE_ID"
  printf 'CODEX_HERDR_GUARDIAN_PID=%q\n' "$$"
} >"$tmp_path"
chmod 600 "$tmp_path"
mv -f "$tmp_path" "$lease_path"

printf '{"herdrKeys":5,"mode":"context-guardian","pid":%d,"status":"ready"}\n' "$$"

while [[ -S "$HERDR_SOCKET_PATH" ]]; do
  sleep "$interval_seconds"
done

die 70 'Herdr server socket disappeared'
