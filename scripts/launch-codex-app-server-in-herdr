#!/usr/bin/env bash
set -euo pipefail

readonly herdr_bin="${CODEX_HERDR_BIN:-$HOME/.local/bin/herdr}"
readonly session_name="${CODEX_HERDR_SESSION:-codex-host}"
readonly state_dir="${CODEX_HERDR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/codex-herdr}"
readonly lease_path="${CODEX_HERDR_LEASE_PATH:-$state_dir/context.env}"
readonly runtime_dir="${CODEX_HERDR_RUNTIME_DIR:-$HOME/.local/libexec/codex-herdr}"
readonly guardian="${CODEX_HERDR_GUARDIAN:-$runtime_dir/codex-herdr-context-guardian}"
readonly proxy="${CODEX_HERDR_PROXY:-$runtime_dir/codex-herdr-proxy}"
readonly log_path="${CODEX_HERDR_LOG_PATH:-$state_dir/herdr-server.log}"
readonly lock_dir="${CODEX_HERDR_LOCK_DIR:-$state_dir/launch.lock}"
readonly wait_seconds="${CODEX_HERDR_WAIT_SECONDS:-20}"

die() {
  local code="$1"
  shift
  printf 'launch-codex-app-server-in-herdr: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<'EOF'
Usage: launch-codex-app-server-in-herdr [start|status]

Start or inspect a headless Herdr context guardian for Codex app-server proxy
processes. This is the Linux/remote counterpart to the macOS ChatGPT guardian.
EOF
}

server_ready() {
  "$herdr_bin" --session "$session_name" status server 2>/dev/null |
    grep -q 'status: running'
}

proxy_ready() {
  CODEX_HERDR_AUTO_START=0 \
  CODEX_HERDR_DRY_RUN=1 \
    CODEX_HERDR_LEASE_PATH="$lease_path" \
    "$proxy" app-server proxy >/dev/null 2>&1
}

status() {
  local server=false lease=false
  server_ready && server=true
  proxy_ready && lease=true
  printf '{"leaseReady":%s,"mode":"status","serverReady":%s,"session":"%s"}\n' \
    "$lease" "$server" "$session_name"
  [[ "$server" == true && "$lease" == true ]]
}

start_server() {
  server_ready && return 0
  nohup "$herdr_bin" --session "$session_name" server >>"$log_path" 2>&1 </dev/null &

  local deadline=$((SECONDS + wait_seconds))
  until server_ready; do
    ((SECONDS < deadline)) || die 70 "Herdr server did not become ready; see $log_path"
    sleep 0.25
  done
}

create_anchor() {
  local response pane_id command
  response="$("$herdr_bin" --session "$session_name" workspace create \
    --cwd "$HOME" --label codex-app-server --no-focus)"
  pane_id="$(printf '%s' "$response" | python3 -c \
    'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')"
  [[ -n "$pane_id" ]] || die 70 'Herdr did not return an anchor pane id'
  printf -v command 'exec %q' "$guardian"
  "$herdr_bin" --session "$session_name" pane run "$pane_id" "$command" >/dev/null

  local deadline=$((SECONDS + wait_seconds))
  until proxy_ready; do
    ((SECONDS < deadline)) || die 70 'Herdr context guardian did not publish a live lease'
    sleep 0.25
  done
}

start() {
  [[ "$(uname -s)" == "Linux" ]] || die 69 'remote app-server guardian is supported only on Linux'
  [[ -x "$herdr_bin" ]] || die 69 "Herdr executable is unavailable: $herdr_bin"
  [[ -x "$guardian" && -x "$proxy" ]] || die 69 'Codex Herdr guardian scripts are unavailable'
  [[ "$wait_seconds" =~ ^[1-9][0-9]*$ ]] || die 64 'wait seconds must be positive'

  umask 077
  mkdir -p "$state_dir"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    die 75 'another Herdr guardian launch is in progress'
  fi
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

  start_server
  proxy_ready || create_anchor
  status
}

case "${1:-start}" in
  start) start ;;
  status) status ;;
  --help|-h|help) usage ;;
  *) usage >&2; die 64 "unknown command: $1" ;;
esac
