#!/usr/bin/env bash
set -euo pipefail

codex_home="${CODEX_HOME:-$HOME/.codex}"
output="$codex_home/config.toml"
force=false
links_only=false

while (($#)); do
  case "$1" in
    --output)
      [[ $# -ge 2 ]] || { echo "--output requires a path" >&2; exit 64; }
      output="$2"
      shift 2
      ;;
    --force)
      force=true
      shift
      ;;
    --links-only)
      links_only=true
      shift
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

link_external_skill() {
  local name="$1"
  local source="$2"
  local target="$codex_home/skills/$name"
  [[ -d "$source" ]] || {
    printf 'optional external skill unavailable: %s (%s)\n' "$name" "$source" >&2
    return 0
  }
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    return 0
  fi
  if [[ -e "$target" || -L "$target" ]]; then
    printf 'refusing to replace existing external skill target: %s\n' "$target" >&2
    return 73
  fi
  mkdir -p "$codex_home/skills"
  ln -s "$source" "$target"
}

link_external_skill agent-wiki "${CODEX_AGENT_WIKI_SKILL:-$HOME/.agents/skills/agent-wiki}"
link_external_skill batdd-bootstrap "${CODEX_BATDD_BOOTSTRAP_SKILL:-$HOME/Documents/repos/github.com/michael-casas/michael-casas/.agents/skills/batdd-bootstrap}"
link_external_skill firecrawl "${CODEX_FIRECRAWL_SKILL:-$HOME/.dotfiles/skills/firecrawl}"

if [[ "$links_only" == true ]]; then
  exit 0
fi

shared="$codex_home/config/config.shared.toml"
prelude="$codex_home/config/config.local.prelude.toml"
append="$codex_home/config/config.local.append.toml"

[[ -f "$shared" ]] || { echo "missing shared config: $shared" >&2; exit 66; }
if [[ -e "$output" && "$force" != true ]]; then
  echo "refusing to replace existing config without --force: $output" >&2
  exit 73
fi
[[ "$codex_home" != *$'\n'* && "$codex_home" != *'"'* ]] || {
  echo "CODEX_HOME contains unsupported TOML path characters" >&2
  exit 65
}

mkdir -p "$(dirname "$output")"
temporary="$(mktemp "${output}.tmp.XXXXXX")"
trap 'rm -f "$temporary"' EXIT

if [[ -f "$prelude" ]]; then
  cat "$prelude" >>"$temporary"
  printf '\n' >>"$temporary"
fi
cat "$shared" >>"$temporary"
printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$codex_home" >>"$temporary"
if [[ -f "$append" ]]; then
  printf '\n' >>"$temporary"
  cat "$append" >>"$temporary"
fi

python3 - "$temporary" <<'PY'
import pathlib
import re
import sys
import tomllib

document = tomllib.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
forbidden_keys = {
    "access_token",
    "api_key",
    "authorization",
    "bearer_token",
    "password",
    "secret",
}
literal_secret = re.compile(r"^(?:Bearer\s+|sk-[A-Za-z0-9_-]{12,})", re.IGNORECASE)

def reject_literals(value, path=()):
    if isinstance(value, dict):
        for key, child in value.items():
            if key.lower() in forbidden_keys and isinstance(child, str) and child.strip():
                raise SystemExit(f"refusing literal credential at {'.'.join((*path, key))}")
            reject_literals(child, (*path, key))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            reject_literals(child, (*path, str(index)))
    elif isinstance(value, str) and literal_secret.match(value.strip()):
        raise SystemExit(f"refusing literal credential at {'.'.join(path)}")

reject_literals(document)
PY

chmod 600 "$temporary"
mv "$temporary" "$output"
trap - EXIT
printf '%s\n' "$output"
