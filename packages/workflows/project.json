{
  "name": "@codex/workflows",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workflows/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:workflows", "layer:domain"],
  "// targets": "to see all targets run: nx show project @codex/workflows --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/workflows",
        "command": "tsc --build tsconfig.lib.json"
      }
    },
    "test-l1-unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/workflows/vitest.config.ts src/lib/fixtures.test.ts src/authoring/authoring.test.ts src/application/commands/submit-workflow-source/__tests__/submit-workflow-source-handler.test.ts --testNamePattern='L1:UNIT'"
      }
    },
    "test-l1-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/workflows/vitest.config.ts src/lib/planning.test.ts src/lib/repairs.test.ts src/authoring/authoring.test.ts --testNamePattern='L1:INTEGRATION'"
      }
    },
    "test-l1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/workflows/vitest.config.ts --exclude '**/*.spec.ts'"
      }
    },
    "test-l2": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config packages/workflows/vitest.config.ts --exclude '**/*.test.ts'"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/test-output/codex-workflows/workflows.json"],
      "options": {
        "command": "bun packages/testing/src/cli.ts aggregate packages/testing/manifests/workflows.json"
      }
    }
  }
}
