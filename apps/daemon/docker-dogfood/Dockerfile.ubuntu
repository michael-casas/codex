FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517
ARG NODE_VERSION=22.18.0
ARG CODEX_VERSION=0.151.0
ARG TARGETARCH
ARG CODEX_UID=1100
ARG CODEX_GID=1100
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils git nginx openssl gosu procps && rm -rf /var/lib/apt/lists/*
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in arm64) arch=arm64;; amd64) arch=x64;; *) exit 1;; esac; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" && \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" && \
    grep " node-v${NODE_VERSION}-linux-${arch}.tar.xz$" SHASUMS256.txt | sha256sum -c - && \
    tar -xJf "node-v${NODE_VERSION}-linux-${arch}.tar.xz" --strip-components=1 -C /usr/local && \
    rm "node-v${NODE_VERSION}-linux-${arch}.tar.xz" SHASUMS256.txt
RUN npm install -g @openai/codex@${CODEX_VERSION} && groupadd -f -g ${CODEX_GID} cas-runtime && useradd --create-home --uid ${CODEX_UID} --gid ${CODEX_GID} --shell /bin/bash codex
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /usr/local/bin/cas-entrypoint
COPY AGENT.md /opt/cas/AGENT.md
RUN chmod 755 /usr/local/bin/cas-entrypoint
ENV CODEX_HOME=/home/codex/.codex NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
EXPOSE 4501 3000
ENTRYPOINT ["/usr/local/bin/cas-entrypoint"]
