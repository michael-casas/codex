{
  "name": "@codex/daemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "scope:orchestration"
    ],
    "targets": {
      "docker-dogfood": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bun apps/daemon/docker-dogfood/run.mjs"
        }
      },
      "test-l2-delivery-failure": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__specs__/workflow-execution-daemon.spec.ts --testNamePattern=DELIVERY-EXHAUSTED-L2"
        }
      },
      "eval-readable": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bun apps/daemon/src/visibility/support/readable-visibility-runtime.fixture.mjs"
        }
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/daemon/dist",
          "format": [
            "esm"
          ],
          "bundle": false,
          "main": "apps/daemon/src/bootstrap.ts",
          "tsConfig": "apps/daemon/tsconfig.app.json",
          "assets": [
            "apps/daemon/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/daemon/dist/package.json",
          "{workspaceRoot}/apps/daemon/dist/bun.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/daemon/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@codex/daemon:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@codex/daemon:build:development"
          },
          "production": {
            "buildTarget": "@codex/daemon:build:production"
          }
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build",
          "test-pre-build"
        ],
        "outputs": [
          "{workspaceRoot}/test-output/ground-zero/daemon.json"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts aggregate packages/testing/manifests/daemon.json"
        },
        "configurations": {
          "ground-zero": {
            "env": {
              "GROUND_ZERO_UNCACHED": "1"
            }
          }
        }
      },
      "test-l1-unit": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/main.test.ts src/workflow-execution/__tests__/workflow-execution-daemon.test.ts src/workflow-execution/__tests__/meadow-workflow-execution-daemon.test.ts src/workflow-execution/__tests__/meadow-visibility.test.ts src/workflow-execution/__tests__/meadow-retry.test.ts --testNamePattern='L1:UNIT'"
        }
      },
      "test-l1-integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/control-runtime.test.ts src/visibility/__tests__/control-visibility.test.ts src/workflow-execution/__tests__/workflow-execution-daemon.test.ts src/workflow-execution/__tests__/readable-recovery.test.ts src/visibility/__tests__/legacy-title-replay.test.ts src/workflow-execution/__tests__/meadow-workflow-execution-daemon.test.ts src/workflow-execution/__tests__/meadow-visibility.test.ts src/workflow-execution/__tests__/meadow-retry.test.ts src/visibility/__tests__/observer-recovery.test.ts --testNamePattern='L1:INTEGRATION'"
        }
      },
      "test-l1": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/main.test.ts src/control-runtime.test.ts src/visibility/__tests__/control-visibility.test.ts src/workflow-execution/__tests__/workflow-execution-daemon.test.ts src/workflow-execution/__tests__/readable-recovery.test.ts src/visibility/__tests__/legacy-title-replay.test.ts src/workflow-execution/__tests__/meadow-workflow-execution-daemon.test.ts src/workflow-execution/__tests__/meadow-visibility.test.ts src/workflow-execution/__tests__/meadow-retry.test.ts src/visibility/__tests__/observer-recovery.test.ts"
        }
      },
      "test-visibility-l1": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/visibility/__tests__/control-visibility.test.ts src/visibility/__tests__/legacy-title-replay.test.ts"
        }
      },
      "test-visibility-l2": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/visibility/__specs__/control-visibility.spec.ts src/visibility/__specs__/legacy-replay.spec.ts"
        }
      },
      "test-l2-e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@codex/codex:build",
          "@codex/delivery:build",
          "@codex/transport:build"
        ],
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/agent-messaging/__specs__/agent-messaging-daemon.spec.ts src/delegation/__specs__/delegation-daemon.spec.ts src/workflow-execution/__specs__/workflow-execution-daemon.spec.ts src/visibility/__specs__/runtime-visibility-daemon.spec.ts src/visibility/__specs__/control-visibility.spec.ts --testNamePattern='L2:E2E' && bun nx test-l2-e2e @codex/daemon-e2e --outputStyle=static"
        }
      },
      "test-l2": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__specs__/project-context.spec.ts && vitest run --config apps/daemon/vitest.config.ts src/control-runtime.spec.ts src/agent-messaging/__specs__/agent-messaging-daemon.spec.ts src/delegation/__specs__/delegation-daemon.spec.ts src/visibility/__specs__/runtime-visibility-daemon.spec.ts src/visibility/__specs__/control-visibility.spec.ts --testNamePattern='L2:E2E' && bun nx test-l2-e2e @codex/daemon-e2e --outputStyle=static && vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__specs__/meadow-recovery.spec.ts src/workflow-execution/__specs__/meadow-ownership.spec.ts && vitest run --config apps/daemon/vitest.config.ts src/visibility/__specs__/observation-recovery.spec.ts --reporter=default --reporter=json --outputFile=test-output/observation/l2.json"
        }
      },
      "test-pre-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p apps/daemon/tsconfig.cucumber.json"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "test-l3": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "test-pre-build"
        ],
        "outputs": [
          "{workspaceRoot}/test-output/cucumber/daemon-remote-workflow.json"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/workflow-execution/remote-workflow-execution.feature apps/daemon/out-tsc/cucumber/workflow-execution/index.steps.js test-output/cucumber/daemon-remote-workflow.json && bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/workflow-execution/project-context.feature apps/daemon/out-tsc/cucumber/workflow-execution/project-context.steps.js test-output/cucumber/project-context.json && bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/workflow-execution/meadow-recovery.feature apps/daemon/out-tsc/cucumber/workflow-execution/meadow-recovery.steps.js test-output/cucumber/meadow-recovery.json && bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/visibility/observation-recovery.feature apps/daemon/out-tsc/cucumber/visibility/observation-recovery.steps.js test-output/cucumber/observation-recovery.json"
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "test-project-context-l2": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__specs__/project-context.spec.ts"
        }
      },
      "test-project-context-l3": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "test-pre-build"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/workflow-execution/project-context.feature apps/daemon/out-tsc/cucumber/workflow-execution/project-context.steps.js test-output/cucumber/project-context.json"
        }
      },
      "test-meadow-l1": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__tests__/meadow-workflow-execution-daemon.test.ts src/workflow-execution/__tests__/meadow-visibility.test.ts src/workflow-execution/__tests__/meadow-retry.test.ts --reporter=default --reporter=json --outputFile=test-output/meadow/l1.json"
        },
        "outputs": [
          "{projectRoot}/test-output/meadow/l1.json"
        ]
      },
      "test-meadow-l2": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/workflow-execution/__specs__/meadow-recovery.spec.ts src/workflow-execution/__specs__/meadow-ownership.spec.ts --reporter=default --reporter=json --outputFile=test-output/meadow/l2.json"
        },
        "dependsOn": [
          "@codex/transport:build"
        ],
        "outputs": [
          "{projectRoot}/test-output/meadow/l2.json"
        ]
      },
      "test-meadow-l3": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "test-pre-build"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/workflow-execution/meadow-recovery.feature apps/daemon/out-tsc/cucumber/workflow-execution/meadow-recovery.steps.js test-output/cucumber/meadow-recovery.json"
        }
      },
      "test-observation-l1": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/visibility/__tests__/observer-recovery.test.ts --reporter=default --reporter=json --outputFile=test-output/observation/l1.json"
        },
        "outputs": [
          "{projectRoot}/test-output/observation/l1.json"
        ]
      },
      "test-observation-l2": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/visibility/__specs__/observation-recovery.spec.ts --reporter=default --reporter=json --outputFile=test-output/observation/l2.json"
        },
        "outputs": [
          "{projectRoot}/test-output/observation/l2.json"
        ]
      },
      "test-observation-l3": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "test-pre-build"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts verify-cucumber apps/daemon/src/visibility/observation-recovery.feature apps/daemon/out-tsc/cucumber/visibility/observation-recovery.steps.js test-output/cucumber/observation-recovery.json"
        },
        "outputs": [
          "{workspaceRoot}/test-output/cucumber/observation-recovery.json"
        ]
      }
    }
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "@types/pg": "^8.21.0"
  },
  "dependencies": {
    "@codex/codex": "workspace:*",
    "@codex/control-gateway": "workspace:*",
    "@codex/db": "workspace:*",
    "@codex/delivery": "workspace:*",
    "@codex/process": "workspace:*",
    "@codex/transport": "workspace:*",
    "@codex/workflows": "workspace:*"
  }
}
