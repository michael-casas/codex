{
  "name": "@orchestration/daemon",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/daemon/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/daemon/src/main.ts",
          "tsConfig": "apps/daemon/tsconfig.app.json",
          "assets": [
            "apps/daemon/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/daemon/dist/package.json",
          "{workspaceRoot}/apps/daemon/dist/bun.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/daemon/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@orchestration/daemon:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@orchestration/daemon:build:development"
          },
          "production": {
            "buildTarget": "@orchestration/daemon:build:production"
          }
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/test-output/ground-zero/daemon.json"
        ],
        "options": {
          "command": "bun packages/testing/src/cli.ts aggregate packages/testing/manifests/daemon.json"
        },
        "configurations": {
          "ground-zero": {
            "env": {
              "GROUND_ZERO_UNCACHED": "1"
            }
          }
        }
      },
      "test-l1-unit": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/main.test.ts --testNamePattern='L1:UNIT'"
        }
      },
      "test-l1": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/daemon/vitest.config.ts src/main.test.ts"
        }
      },
      "test-l2-e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun nx test-l2-e2e @orchestration/daemon-e2e --outputStyle=static"
        }
      },
      "test-l2": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun nx test-l2-e2e @orchestration/daemon-e2e --outputStyle=static"
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {}
}
