{
  "name": "@codex/codex-monitor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/codex-monitor/src",
  "projectType": "application",
  "tags": ["type:app", "scope:monitor", "layer:delivery"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/codex-monitor"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc --build apps/codex-monitor/tsconfig.app.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build apps/codex-monitor/tsconfig.json"
      }
    },
    "test-l1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/codex-monitor/vitest.config.ts scripts/monitor.test.ts src/app-server/state.test.ts"
      }
    },
    "test-l2": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run --config apps/codex-monitor/vitest.config.ts scripts/monitor.spec.ts src/app-server/client.spec.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["lint", "typecheck", "build", "test-l1", "test-l2"],
      "options": { "command": "echo codex-monitor TypeScript checks complete" }
    }
  }
}
