{
  "name": "@codex/codex-control-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/codex-control-ui/src",
  "tags": ["npm:private", "type:app", "scope:control-ui", "layer:delivery"],
  "// targets": "to see all targets run: nx show project @codex/codex-control-ui --web",
  "targets": {
    "test-l1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/codex-control-ui/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/codex-control-ui",
        "command": "svelte-check --tsconfig ./tsconfig.app.json"
      }
    }
  }
}
