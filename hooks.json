{
  "description": "Codex lifecycle hooks for Herdr state and enforced per-session SQLite scratchpad compaction recovery.",
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/post-compact-checkpoint.py\"",
            "statusMessage": "Verifying session scratchpad",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "^(manual|auto)$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/pre-compact-checkpoint.py\"",
            "statusMessage": "Checkpointing session scratchpad",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(manual|auto)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/restore-session-context.py\"",
            "statusMessage": "Enforcing session scratchpad",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/mcasa_atlantis/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs' ] || node '/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs'",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \"/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs\" (node \"/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs\" & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs' ] || node '/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs'",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \"/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs\" (node \"/Users/mcasa_atlantis/.agents/skills/impeccable/scripts/hook.mjs\" & exit /b)"
          }
        ]
      }
    ]
  }
}
