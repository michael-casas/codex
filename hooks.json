{
  "description": "Codex lifecycle hooks for Herdr state and enforced per-session SQLite scratchpad compaction recovery.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/restore-session-context.py\"",
            "statusMessage": "Enforcing session scratchpad",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/pre-compact-checkpoint.py\"",
            "statusMessage": "Checkpointing session scratchpad",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/data-substrate/scripts/post-compact-checkpoint.py\"",
            "statusMessage": "Verifying session scratchpad",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
